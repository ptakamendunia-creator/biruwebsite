# Salin menjadi .env lalu isi. JANGAN commit file .env.
NODE_ENV=production
PORT=3000

# URL publik lengkap tanpa garis miring akhir. Dipakai untuk canonical, sitemap, dan JSON-LD.
SITE_URL=https://domain-anda.example

# Wajib pada production: minimal 32 karakter acak.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Isi 1 jika di belakang reverse proxy (Nginx, Cloudflare, dsb.) agar IP klien dan rate limit benar.
TRUST_PROXY=1

# Lokasi data (relatif terhadap folder proyek). Default sudah sesuai.
DB_PATH=data/site.db
UPLOAD_DIR=data/uploads
BACKUP_DIR=data/backups

# Email notifikasi form kontak (opsional; tanpa ini pesan tetap tersimpan di database).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nama Situs <no-reply@domain-anda.example>"
MAIL_TO=halo@domain-anda.example
