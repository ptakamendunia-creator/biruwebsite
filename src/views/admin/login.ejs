<%- include('_head', { title: 'Masuk' }) %>
<div class="login-card">
  <img src="/img/logo.png" alt="" width="64" height="64">
  <h1>Masuk Admin</h1>
  <p class="muted"><%= s.site_name %></p>
  <% if (error) { %><div class="flash err" role="alert"><%= error %></div><% } %>
  <form method="post" action="/admin/login" autocomplete="on">
    <label for="email">Email</label>
    <input id="email" name="email" type="email" value="<%= email %>" required autocomplete="username" autofocus>
    <label for="password">Kata sandi</label>
    <input id="password" name="password" type="password" required autocomplete="current-password">
    <button class="btn primary" type="submit">Masuk</button>
  </form>
  <a class="muted small" href="/">&larr; Kembali ke website</a>
</div>
<%- include('_foot') %>
