<%- include('_head', { title: 'Akun saya' }) %>
<div class="page-h"><h1>Akun saya</h1></div>
<form class="panel form" method="post" action="/admin/account">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <p class="muted">Masuk sebagai <b><%= me.email %></b> (<%= me.role %>). Mengganti kata sandi akan mengeluarkan sesi lain.</p>
  <div class="field"><label for="a-cur">Kata sandi saat ini</label><input id="a-cur" name="current" type="password" required autocomplete="current-password"></div>
  <div class="field"><label for="a-new">Kata sandi baru (min. 10 karakter)</label><input id="a-new" name="password" type="password" minlength="10" required autocomplete="new-password"></div>
  <div class="field"><label for="a-cf">Ulangi kata sandi baru</label><input id="a-cf" name="confirm" type="password" minlength="10" required autocomplete="new-password"></div>
  <div class="form-actions"><button class="btn primary" type="submit">Ganti kata sandi</button></div>
</form>
<%- include('_foot') %>
