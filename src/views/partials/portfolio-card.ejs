<article class="work-card tone-<%= it.tone %> reveal" data-cat="<%= it.category %>">
  <div class="work-thumb" role="img" aria-label="Ilustrasi contoh proyek: <%= it.title %>">
    <% if (it.image) { %><img src="<%= it.image %>" alt="Contoh tampilan website: <%= it.title.replace(/^Contoh\s+/i, '') %>" loading="lazy" width="1200" height="675"><% } else { %><div class="mock"><i></i><i></i><i></i><b></b><b></b><b></b></div><% } %>
    <span class="work-badge">Contoh</span>
  </div>
  <div class="work-body">
    <span class="eyebrow"><%= it.category %><% if (it.industry) { %> · <%= it.industry %><% } %></span>
    <h3><%= it.title %></h3>
    <% if (it.url) { %><a class="text-link" href="<%= it.url %>" target="_blank" rel="noopener noreferrer">Kunjungi Website <%- icon('arrow', 14) %></a><% } else { %><a class="text-link" href="/kontak">Diskusikan proyek serupa <%- icon('arrow', 14) %></a><% } %>
  </div>
</article>
