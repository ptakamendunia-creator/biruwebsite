<%- include('../partials/head') %>
<%- include('../partials/header') %>
<%- include('../partials/crumbs') %>

<section class="page-hero">
  <div class="container">
    <span class="eyebrow">Artikel &amp; Panduan</span>
    <h1>Wawasan Digital untuk <em>Keputusan yang Lebih Terarah.</em></h1>
    <p class="lead">Panduan praktis seputar perencanaan, pembuatan, pengelolaan, dan pengembangan website bisnis.</p>
  </div>
</section>

<section class="section section-mist">
  <div class="container">
    <% if (!articles.length) { %><p class="empty">Belum ada artikel.</p><% } %>
    <div class="grid grid-3">
      <% articles.forEach(function (a) { %>
        <article class="card art-card reveal">
          <span class="eyebrow"><%= a.label || a.category %></span>
          <h2 class="h3"><a href="/artikel/<%= a.slug %>"><%= a.title %></a></h2>
          <p><%= a.excerpt %></p>
          <a class="text-link" href="/artikel/<%= a.slug %>">Baca artikel <%- icon('arrow-right', 14) %></a>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<%- include('../partials/cta', { ctaTitle: 'Diskusikan Kebutuhan Website Anda Bersama Tim Kami.' }) %>
<%- include('../partials/footer') %>
